# --- Servidor ---
PORT=4000
NODE_ENV=development
# Uno o varios orígenes separados por coma
FRONTEND_URL=http://localhost:5173

# --- Base de datos (URL externa de Render) ---
DATABASE_URL=postgresql://usuario:password@host.oregon-postgres.render.com/geoscript
# Render exige SSL. Pon "false" solo si usas un Postgres local sin SSL
DATABASE_SSL=true

# --- Auth ---
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=7d
# Minutos que dura el código de 6 dígitos (confirmación / reset)
TOKEN_TTL_MINUTES=15
# Horas que dura el enlace de invitación del personal (Administración → Responsables)
INVITE_TTL_HOURS=72
# Solo desarrollo: "true" imprime en consola los códigos de 6 dígitos (nunca los enlaces de invitación).
# Déjalo vacío en cualquier entorno compartido: los logs no deben contener secretos.
DEV_LOG_AUTH_CODES=
# sync({ alter: true }) solo se aplica contra una BD local (localhost). Pon "true" para forzarlo
# o "false" para desactivarlo. NUNCA lo actives con la base de datos de Render.
DB_SYNC_ALTER=

# --- Superusuario inicial (se crea/actualiza al arrancar) ---
# Solo para crear la PRIMERA cuenta de administrador. El resto del personal se da de alta
# desde Administración → Responsables (invitación por correo), nunca en este archivo.
# Después del primer arranque en producción, cambia esa contraseña con "¿Olvidaste tu contraseña?"
# y retira ADMIN_PASSWORD del entorno (si la cuenta ya existe, el arranque no la necesita).
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@geoscript.local
ADMIN_PASSWORD=CambiaEstePassword123

# --- Correo (códigos de confirmación, recuperación de password e invitaciones del personal) ---
# Proveedor: si BREVO_API_KEY tiene valor se usa la API HTTP de Brevo; si está vacía, el SMTP de abajo.
# Al arrancar, la API valida la configuración y avisa en consola si algo impide la entrega.
# Diagnóstico sin enviar: npm run mail:test -- --check
# Prueba un envío real con: npm run mail:test -- tu@correo.com   (añade --smtp para forzar SMTP)
#
# Brevo (recomendado para producción):
#   1. Brevo → SMTP y API → Claves de API → "Generar una nueva clave". Copia SOLO el valor,
#      que empieza por xkeysib- (sin el nombre de la clave ni ":" delante).
#      Si la clave tiene permisos restringidos, debe incluir el envío de correos transaccionales.
#   2. Brevo → Remitentes, dominios e IP dedicadas → añade y valida el correo de MAIL_FROM
#      (idealmente un dominio propio autenticado con DKIM/DMARC).
#   3. Si activas "IP autorizadas" en Brevo, agrega las IP de salida del servidor (Render).
# Es un secreto: nunca lo subas al repositorio; en Render se define en Environment.
BREVO_API_KEY=
#
# SMTP (respaldo; se usa solo si BREVO_API_KEY está vacía):
# El sandbox de Mailtrap (sandbox.smtp.mailtrap.io) NO entrega a correos reales:
# los mensajes solo aparecen en tu bandeja de pruebas de Mailtrap.
# Para que lleguen al usuario, por ejemplo con Gmail:
#   1. Activa la verificación en 2 pasos en tu cuenta de Google
#   2. Crea una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
#   3. SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=tucuenta@gmail.com
#      SMTP_PASS=<contraseña de aplicación de 16 letras>  MAIL_FROM="GeoScript <tucuenta@gmail.com>"
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
# true para TLS directo (puerto 465). Si se omite se deduce del puerto
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Remitente para ambos proveedores. Debe ser uno que tu proveedor permita
# (con Brevo: un remitente validado; con Gmail: tu misma cuenta).
# Un dominio .local/.test lo rechazan los proveedores reales.
MAIL_FROM="GeoScript <no-reply@geoscript.local>"

# --- Imágenes (almacenamiento local) ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# --- Moderación ---
# Número de denuncias pendientes para ocultar un reporte automáticamente
FLAG_AUTOHIDE=5

# --- Seguimiento ---
# Días que un reporte resuelto sigue visible en el mapa antes de retirarse
RESOLVED_VISIBLE_DAYS=2
# Zona horaria para estadísticas y PDF
APP_TIMEZONE=America/Mexico_City

# --- Distribución de reportes ---
# false desactiva la asignación automática al área de la categoría
AUTO_ASSIGN_REPORTS=true
# Días sin movimiento para considerar un reporte "estancado" (recordatorios)
STALE_REPORT_DAYS=5

# --- Automatizaciones (opcional, n8n u otro orquestador) ---
# Si se deja vacío no se envía nada y la plataforma funciona igual.
# URL del nodo "Webhook" de n8n que recibe los eventos (report.created, report.status_changed, ...)
N8N_WEBHOOK_URL=
# Secreto compartido para firmar cada evento (cabecera X-GeoScript-Signature, HMAC-SHA256)
N8N_WEBHOOK_SECRET=
# Habilita GET /api/integrations/stale-reports para que n8n consulte reportes estancados (cabecera X-API-Key)
INTEGRATION_API_KEY=

# --- Cuentas de prueba (SOLO base de datos local) ---
# Crea / verifica las 3 cuentas con: npm run db:test-users
# El script es idempotente, no cambia passwords existentes (salvo --reset-passwords)
# y se niega a correr con NODE_ENV=production o contra una base de datos de Render.
# Usa comillas si el password lleva "#" (en .env inicia un comentario).
TEST_ADMIN_NAME="Admin de Prueba"
TEST_ADMIN_EMAIL=admin.prueba@geoscript.test
TEST_ADMIN_PASSWORD="cambia-este-password"
TEST_OPERATOR_NAME="Operativo de Prueba"
TEST_OPERATOR_EMAIL=operativo.prueba@geoscript.test
TEST_OPERATOR_PASSWORD="cambia-este-password"
# slug del área del personal operativo (ver Administración → Áreas)
TEST_OPERATOR_AREA=obras-publicas
TEST_CITIZEN_NAME="Ciudadano de Prueba"
TEST_CITIZEN_EMAIL=ciudadano.prueba@geoscript.test
TEST_CITIZEN_PASSWORD="cambia-este-password"

# BD local de pruebas (p. ej. Docker). La usan "npm run db:test-users" y "npm run dev:test"
# en lugar de DATABASE_URL, así no hace falta tocar la conexión de Render.
#   docker run -d --name geoscript-pg-test -e POSTGRES_USER=geoscript -e POSTGRES_PASSWORD=geoscript_local -e POSTGRES_DB=geoscript_test -p 55432:5432 postgres:16-alpine
TEST_DATABASE_URL=postgresql://geoscript:geoscript_local@localhost:55432/geoscript_test
