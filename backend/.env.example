# --- Servidor ---
PORT=4000
NODE_ENV=development
# Uno o varios orígenes separados por coma
FRONTEND_URL=http://localhost:5173

# --- Base de datos (URL externa de Render) ---
DATABASE_URL=postgresql://usuario:password@host.oregon-postgres.render.com/geoscript
# Render exige SSL. Pon "false" solo si usas un Postgres local sin SSL
DATABASE_SSL=true

# --- Auth ---
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=7d
# Minutos que dura el código de 6 dígitos (confirmación / reset)
TOKEN_TTL_MINUTES=15

# --- Superusuario (se crea/actualiza al arrancar) ---
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@geoscript.local
ADMIN_PASSWORD=CambiaEstePassword123

# --- Correo (códigos de confirmación y de recuperación de password) ---
# Al arrancar, la API valida la conexión SMTP y avisa en consola si algo impide la entrega.
# Prueba un envío real con: npm run mail:test -- tu@correo.com
#
# El sandbox de Mailtrap (sandbox.smtp.mailtrap.io) NO entrega a correos reales:
# los mensajes solo aparecen en tu bandeja de pruebas de Mailtrap.
# Para que lleguen al usuario, por ejemplo con Gmail:
#   1. Activa la verificación en 2 pasos en tu cuenta de Google
#   2. Crea una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
#   3. SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=tucuenta@gmail.com
#      SMTP_PASS=<contraseña de aplicación de 16 letras>  MAIL_FROM="GeoScript <tucuenta@gmail.com>"
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
# true para TLS directo (puerto 465). Si se omite se deduce del puerto
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Debe ser un remitente que tu proveedor permita (con Gmail, tu misma cuenta).
# Un dominio .local/.test lo rechazan los proveedores reales.
MAIL_FROM="GeoScript <no-reply@geoscript.local>"

# --- Imágenes (almacenamiento local) ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# --- Moderación ---
# Número de denuncias pendientes para ocultar un reporte automáticamente
FLAG_AUTOHIDE=5

# --- Seguimiento ---
# Días que un reporte resuelto sigue visible en el mapa antes de retirarse
RESOLVED_VISIBLE_DAYS=2
# Zona horaria para estadísticas y PDF
APP_TIMEZONE=America/Mexico_City

# --- Distribución de reportes ---
# false desactiva la asignación automática al área de la categoría
AUTO_ASSIGN_REPORTS=true
# Días sin movimiento para considerar un reporte "estancado" (recordatorios)
STALE_REPORT_DAYS=5

# --- Automatizaciones (opcional, n8n u otro orquestador) ---
# Si se deja vacío no se envía nada y la plataforma funciona igual.
# URL del nodo "Webhook" de n8n que recibe los eventos (report.created, report.status_changed, ...)
N8N_WEBHOOK_URL=
# Secreto compartido para firmar cada evento (cabecera X-GeoScript-Signature, HMAC-SHA256)
N8N_WEBHOOK_SECRET=
# Habilita GET /api/integrations/stale-reports para que n8n consulte reportes estancados (cabecera X-API-Key)
INTEGRATION_API_KEY=
